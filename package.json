{
  "name": "dsh-aionui-layout",
  "version": "0.1.0",
  "private": true,
  "description": "AionUi-style two-column DSH right Sidebar (preview/files window + changes) seeded on top of dsh-better-sidebar, without giving up any better-sidebar feature.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "license": "MIT"
}
